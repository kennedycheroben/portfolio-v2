# ==============================================================================
# Portfolio 2.0 — Environment Configuration Template (.env.example)
#
# IMPORTANT SECURITY GUIDANCE:
# 1. Never commit real credentials, production secrets, or private keys to git.
# 2. Server-only secrets (ADMIN_AUTH_SECRET, ADMIN_PASSWORD) must NEVER be
#    prefixed with VITE_* to ensure they are never bundled into client JavaScript.
# 3. In production, configure these variables directly in your hosting dashboard (Vercel).
# ==============================================================================

# Public Site Configuration
VITE_SITE_URL=https://kennedycheroben.co.ke

# Server-Side Administrative CMS Security (Server-only / never exposed to browser)
# Generate a cryptographically secure random secret (e.g., openssl rand -base64 32)
ADMIN_AUTH_SECRET=your-random-hmac-sha256-signing-secret-placeholder-min-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-strong-production-password-placeholder-min-16-chars

# Supabase (Public Client-Safe Keys ONLY — DO NOT USE SERVICE ROLE KEY)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key-placeholder

# Cloudflare Turnstile (Public site key placeholder for bot deterrence)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-placeholder
